# قالب إعداد عميل واحد. يُنسخ إلى .env ويُعدَّل لكل عميل.
# في Portainer: تُوضع هذه القيم في قسم Environment variables للـstack.

# اسم العميل: يُشتقّ منه اسم كل حاوية (alsaqr_web ...).
# حروف لاتينية صغيرة وأرقام وشرطة سفلية فقط.
COMPANY=alsaqr

# منافذ المضيف — فريدة لكل عميل على المضيف نفسه
WEB_PORT=5001
ADMS_PORT=8091

# التوقيت: الكويت لا تعمل بالتوقيت الصيفي.
# ساعة النظام مصدر طوابع الحضور، وخطؤها يزيح الأجر مباشرةً.
TZ=Asia/Kuwait

# الربط: عند التشغيل خلف وسيط (Plesk / nginx) اضبطها 127.0.0.1 فلا يُنشر
# المنفذ على الشبكة — الوسيط يصل عبر شبكة Docker الداخلية. تركها فارغة
# يُبقي مسلكًا مباشرًا بلا تشفير يتخطّى الوسيط وشهادته.
BIND=127.0.0.1
